#!/bin/bash

# omarchy — GRUB-safe update wrapper (installed to /usr/local/bin/omarchy).
#
# Wraps `omarchy update` so the boot config is captured before the update and
# repaired after it, whether the update succeeded or failed. The built-in
# built-in reboot confirm is suppressed so the update always returns to us;
# the wrapper offers reboot only after the post-update repair has verified the
# GRUB boot config is intact.
#
# Stages stream live to the terminal in the running order below and append
# to $STAGE_LOG.

set -uo pipefail

# Resolve the real (non-symlink) directory even when this file is installed as
# a symlink (e.g. /usr/local/bin/omarchy → the repo copy), so grub-guard.sh is
# found beside it regardless of where the link sits.
_self="$(readlink -f "${BASH_SOURCE[0]}")"
SOLVER_SRC="$(cd -- "$(dirname -- "$_self")" && pwd)"
GUARD="$SOLVER_SRC/grub-guard.sh"
STAGE_LOG="$HOME/.local/state/omarchy/update-wrapper.log"

mkdir -p "$(dirname "$STAGE_LOG")"

stage() {
  local n="$1" total="$2" name="$3"
  printf '\n\033[1;36m[stage %s/%s] %s\033[0m\n' "$n" "$total" "$name"
  printf '%s  [omarchy-wrapper] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "stage $n/$total: $name" >>"$STAGE_LOG"
}

log_line() {
  printf '%s  [omarchy-wrapper] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$STAGE_LOG"
}

main() {
  gum style --border normal --border-foreground 36 --padding "1 2 " \
    "Omarchy update wrapper" "" "Stage-by-stage GRUB-safe update" 2>/dev/null || true

  # Authenticate once up front: stage 1 reads root-only boot files and the
  # updater needs sudo anyway. The updater re-execs into a fresh pty, so its
  # sudo ticket differs from this one — a second (obscured) prompt inside the
  # updater is normal, not a bug.
  echo "==> Authenticating sudo (boot-guard reads + the updater)..."
  if ! sudo -v; then
    echo -e "\033[31mSudo authentication failed; aborting.\033[0m" >&2
    exit 1
  fi

  stage 1 4 "prepare boot config snapshot"
  if "$GUARD" --capture; then
    echo "  -> boot config captured; proceeding"
    log_line "capture OK"
  else
    echo -e "\033[31m[grub-guard] pre-update capture failed; aborting update (no known-good baseline).\033[0m" >&2
    log_line "capture FAILED; aborting"
    exit 1
  fi

  stage 2 4 "omarchy update"
  echo "  -> you may be asked for your sudo password again inside the updater (normal)"

  # The updater's omarchy-update-restart ends with `gum confirm ... && reboot`,
  # which would reboot the machine away before our repair stage runs. Instead
  # of starving stdin (</dev/null), which also broke sudo's obscured prompts
  # and the live output stream, stub `gum confirm` only: every confirm auto-
  # declines (reboot never happens here) while everything else — the tty,
  # sudo password masking, pacman interaction, live log streaming — passes
  # through untouched.
  gum_stub_dir="$(mktemp -d /tmp/omarchy-guard-gum.XXXXXX)"
  trap 'rm -rf "$gum_stub_dir"' EXIT
  cat >"$gum_stub_dir/gum" <<'STUB'
#!/bin/bash
[[ ${1:-} == "confirm" ]] && exit 1
exec /usr/bin/gum "$@"
STUB
  chmod +x "$gum_stub_dir/gum"

  OMARCHY_UPDATE_UNATTENDED=1 PATH="$gum_stub_dir:$PATH" omarchy-update -y "$@"
  status=$?
  if (( status == 0 )); then
    printf '  -> omarchy update exit status: %s (OK)\n' "$status"
  else
    printf '  -> omarchy update exit status: %s (FAILED)\n' "$status"
  fi
  log_line "update finished with status $status"

  stage 3 4 "grub-guard repair (always runs)"
  # A long update outlives the initial sudo ticket; every repair sudo call
  # would otherwise silently prompt mid-repair (or hang an invisible gum).
  echo "  -> refreshing sudo credentials for the repair stage"
  if ! sudo -v; then
    echo -e "\033[31m[grub-guard] sudo re-authentication failed; skipping repair. Run 'grub-guard --repair' manually.\033[0m" >&2
    log_line "stage-3 skipped: sudo refresh failed"
    repair_failed=1
  else
    if ! "$GUARD" --repair; then
      echo -e "\033[31m[grub-guard] repair step reported failures; review output above.\033[0m" >&2
      log_line "repair reported failures"
      repair_failed=1
    else
      log_line "repair OK"
      repair_failed=0
    fi
  fi

  stage 4 4 "summary"
  if (( status != 0 )); then
    echo -e "\033[31mUpdate FAILED (exit $status). Boot config was repaired; review the log above before retrying.\033[0m"
  elif (( repair_failed != 0 )); then
    echo -e "\033[31mUpdate OK but boot-guard repair FAILED. Do NOT reboot until 'grub-guard --repair' completes successfully.\033[0m"
    echo -e "\033[1;33m Diff: sudo bash $GUARD --explain-diff\033[0m"
    echo -e "\033[1;33m AI assist: open your assistant in $(dirname "$(dirname "$GUARD")") (skill: omarchy-boot-rescue)\033[0m"
    log_line "gate: no reboot offered because repair failed"
  else
    echo -e "\033[32mUpdate completed successfully. Boot config verified.\033[0m"
    echo
    # Render the confirm only when a real tty is attached, so it can never sit
    # invisibly waiting for Enter (the stage-4 incident); otherwise tell the
    # user plainly how to reboot.
    if [[ -t 0 ]] && [[ -t 1 ]]; then
      gum confirm "Reboot to finish applying updates?" </dev/tty >/dev/tty 2>&1 && omarchy-system-reboot || \
        { echo "(no reboot selected — reboot manually with 'systemctl reboot' when ready)"; }
    else
      echo "(non-interactive session: reboot manually with 'systemctl reboot' when ready)"
    fi
  fi
  log_line "finished with status $status"
  exit "$status"
}

main "$@"